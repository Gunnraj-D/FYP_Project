    <child link="link_1"/>
    <origin xyz="0 0 0.1575" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.9670597283903604" upper="2.9670597283903604" effort="300" velocity="10"/>
