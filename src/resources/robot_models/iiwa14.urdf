  <!-- Fixed joint to end-effector -->
  <joint name="joint_ee" type="fixed">
    <parent link="link_7"/>
    <child link="link_ee"/>
    <origin xyz="0 0 0.045" rpy="0 -1.5707963267948966 0"/>
  </joint>

  <link name="link_ee"/>

  <!-- TCP link for PyBullet solver compatibility (gripper tip reference) -->
  <joint name="link_ee_to_tcp" type="fixed">
    <parent link="link_ee"/>
    <child link="tcp"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>  <!-- Zero offset; adjust if gripper added later -->
  </joint>

  <link name="tcp"/>

  <!-- Alternative EE for KUKA -->
  <joint name="joint_ee_kuka" type="fixed">
    <parent link="link_7"/>
    <child link="link_ee_kuka"/>
    <origin xyz="0 0 0.045" rpy="3.141592653589793 3.141592653589793 3.141592653589793"/>
  </joint>

  <link name="link_ee_kuka"/>

  <!-- Alternative for MFT Pneum -->
  <joint name="joint_ee_kuka_mft_pneum" type="fixed">
