{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug GG-CNN2 Example",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/examples/debug_ggcnn2_example.py",
            "cwd": "${workspaceFolder}/src",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        }
    ]
}